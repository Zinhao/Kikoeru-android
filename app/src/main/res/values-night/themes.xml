<resources>
    <!-- Base application theme. -->
    <style name="Theme.Kikoeru" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/main_dark</item>
        <item name="colorPrimaryVariant">@color/main_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/main_dark</item>
        <item name="android:colorBackground">@color/black_tran</item>

        <item name="colorSecondaryVariant">@color/green</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" >@color/main_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:navigationBarColor">@color/main_dark</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Customize your theme here. -->
        <item name="android:textColorPrimary">@color/white</item>
        <item name="colorSurface">@color/main_dark</item>
        <item name="colorOnSurface">@color/white</item>
    </style>

    <style name="Theme.Kikoeru.TextInputStyle">
        <item name="android:textColor">@color/white</item>
    </style>
</resources>