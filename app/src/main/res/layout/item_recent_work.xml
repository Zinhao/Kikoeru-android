<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="2dp"
                android:padding="8dp"
                android:elevation="10dp"
                android:background="@drawable/card_bg_work"
              android:orientation="horizontal"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
            android:id="@+id/ivCover"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_no_cover"
            android:transitionName="hero_image"
            android:layout_marginTop="0dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="0dp"/>

    <LinearLayout android:layout_width="match_parent"
                  android:layout_height="match_parent"
                  android:layout_marginStart="5dp"
                  android:orientation="vertical">
        <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/ivCover"
                android:layout_marginTop="2dp"
                android:layout_toEndOf="@+id/ivCover"
                android:text="@string/local_works"
                android:padding="4dp"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
        />

        <TextView
                android:id="@+id/tvRJ"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:padding="4dp"
                android:visibility="visible"
                android:text="rj90876"
        />

        <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg_text"
                android:padding="6dp"
                android:text="2022-01-02"
                android:textColor="@color/white"
                android:textSize="10sp"
                app:layout_constraintTop_toBottomOf="@+id/tvCircles" app:layout_constraintStart_toStartOf="@+id/tvCircles"
                android:layout_marginTop="4dp"/>
    </LinearLayout>





</LinearLayout>